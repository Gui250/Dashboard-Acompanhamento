DATABASE_URL=postgres://v4:v4@localhost:5432/v4_dashboard
PORT=3333
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
SETTINGS_SECRET=troque-por-um-segredo-longo-e-aleatorio
CORS_ORIGIN=http://localhost:3000
# Google Ads (opcional). Conexão direta via credenciais padrão do Google (ADC): aponte para a chave JSON de uma
# conta de serviço (o e-mail dela precisa ser usuário na conta do Google Ads). No GCP, a conta de serviço da máquina já vale.
# Sem ADC, dá para colar o JSON e o developer token em Integrações.
GOOGLE_APPLICATION_CREDENTIALS=
# Login OAuth (opcional): OAuth client "Aplicativo da Web"; o redirect URI cadastrado lá tem que ser igual ao daqui.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/integrations/google/callback
# Developer token: Central de API da conta administradora (MCC) do Google Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Servidor MCP em /mcp: chave fixa para integrações (Bearer). Sem ela, só o JWT do login entra. Gere com: openssl rand -hex 32
MCP_API_KEY=
# E-mail de aprovação do kanban (card entra em Revisão) via Resend. RESEND_FROM precisa ser de um domínio verificado
# no Resend, ex.: "Kanban V4 <kanban@v4.company>". Sem as duas, o card muda normalmente e o envio só vira aviso no log.
RESEND_API_KEY=
RESEND_FROM=
