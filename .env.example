# Copie para .env (na raiz) e preencha. Usado pelo docker-compose.yml (produção).

# Postgres. Use só letras, números, "-" e "_" na senha (ela vai dentro da DATABASE_URL).
POSTGRES_USER=v4
POSTGRES_PASSWORD=
POSTGRES_DB=v4_dashboard

# Segredos — gere com: openssl rand -hex 32
JWT_SECRET=
# Cifra a chave da OpenAI salva no banco: se trocar, a chave salva fica ilegível e precisa ser recadastrada.
SETTINGS_SECRET=

# Portas publicadas no host
API_PORT=3333
WEB_PORT=3000

# URL pública da API, como o NAVEGADOR a acessa. Embutida no build do front: mudou = rebuild do web.
NEXT_PUBLIC_API_URL=http://localhost:3333
# Origem(ns) do front aceitas pela API, separadas por vírgula.
CORS_ORIGIN=http://localhost:3000

# Google Ads (opcional). Sem as 4, a integração fica desabilitada.
# OAuth client "Aplicativo da Web" no Google Cloud; o redirect URI cadastrado lá tem que ser igual ao daqui.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/integrations/google/callback
# Developer token: Central de API da conta administradora (MCC) do Google Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Servidor MCP em /mcp: chave fixa para integrações (Bearer). Sem ela, só o JWT do login entra.
MCP_API_KEY=

# E-mail de aprovação do kanban via Resend (opcional). RESEND_FROM de domínio verificado no Resend,
# ex.: "Kanban V4 <kanban@v4company.com>". Sem as duas, o envio só vira aviso no log.
RESEND_API_KEY=
RESEND_FROM=
